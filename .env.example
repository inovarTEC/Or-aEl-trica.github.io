# Netlify > Site configuration > Environment variables (nunca suba o .env real para o GitHub)
MP_ACCESS_TOKEN=          # credencial SECRETA do Mercado Pago (TEST-... para teste, APP_USR-... em produção)
PRECO=5.90                # valor do PDF em reais
PIX_EXPIRA_MIN=30         # validade do QR Code em minutos (mínimo 30 no Mercado Pago)
TESTE_SENHA=              # senha da rota /api/pdf-teste (vazio = rota desativada, responde 404)
NEXT_PUBLIC_MODO_TESTE=   # 'true' mostra o painel de PDF de teste (vazio em produção)
